# Ship the whole .claude/ project config (skills, hooks, commands, agents,
# settings.json, launch.json + serve-preview.mjs) so both machines stay in sync.
# Exclude only the genuinely per-machine files:
#   - settings.local.json: local permission grants, not meant to be shared.
.claude/settings.local.json
*.local.json
#   - transient runtime state (lock files, etc.)
.claude/*.lock
#   - per-machine `claude --resume <id>` shortcut; session ids don't transfer.
claude.session

# Full-resolution dungeon / battlemap sources (the user's CzePeku / Tom Cartos
# subscription downloads and other licensed assets) are kept LOCAL ONLY and never
# published. Drop full-res originals in a `_full/` subfolder: under a campaign's
# maps/ (published/gm-notes/...) for campaign-specific art, or under the shared
# map-library/ (now the private tools/map-library/) for reusable libraries. Only
# the downsized web copies (and committed text catalogues) reach GitHub. Every
# `_full` is a link into the Syncthing sync folder (map-library/, published-full/;
# tools/check_setup.py --link), so the whole path is ignored, link or folder.
published/gm-notes/**/_full
tools/**/_full

# pf2e encounter-builder: the cloned Foundry bestiary source (~250MB, re-clonable)
# and the rebuildable SQLite snapshot are local-only build artifacts. Run
# `python rebuild.py` to regenerate both. Homebrew creature JSON IS committed.
tools/encounterBuilder/_sources/
tools/encounterBuilder/bestiary.db
tools/encounterBuilder/items.db
tools/encounterBuilder/__pycache__/

# Python bytecode caches anywhere under the GM tools.
__pycache__/
*.pyc

# API keys / secrets for the GM tools - LOCAL ONLY, never
# committed. They live in the Syncthing sync folder's keys/, linked into tools/keys/ (tools/check_setup.py --link);
# this glob also covers the legacy next-to-script location.
tools/**/*_key.txt
**/*.secret
**/*.key
tools/**/.env
# Belt and braces: ignore EVERYTHING in tools/keys/ except the two files that
# are meant to be tracked. The *_key.txt glob above missed falai.key (2026-09),
# which sat untracked-but-visible and would have been swept up by `git add -A`.
tools/keys/*
!tools/keys/.gitkeep
!tools/keys/README.md

# Generated image-gen output (the approved generated art) IS committed for
# portability: portraits/, frames/, and the baked tokens/ travel with the repo
# (generation is non-deterministic, so the prompts alone can't reproduce the
# exact approved cast). Only genuine scratch is ignored: upload path maps, variant
# test-bakes, and re-upload temp dirs. (Keys and __pycache__ are ignored above.)
# Machine addresses (Foundry server, ComfyUI) never enter the repo at all: they
# live in ~/.config/tyrnarra/ (see tools/README.md).
published/gm-notes/**/forge_urls.json
tools/**/forge_urls.json
published/gm-notes/**/foundry_urls.json
tools/**/foundry_urls.json
published/gm-notes/**/tokens/_variant-*
published/gm-notes/**/tokens/_reup/

# Local staging inbox for generated art (e.g. Midjourney PNGs) before they are
# converted to the committed web webp. The source PNGs stay local only.
/incoming/

# Obsidian vault (open the repo root as a vault to read lore/ with backlinks).
# Only app.json is committed: it pins standard markdown links with relative
# paths (so links keep working on GitHub and in plain editors) and hides the
# non-markdown folders from the graph. Everything else in .obsidian/ is
# per-machine state (workspace, cache, plugins) and changes on every open.
.obsidian/*
!.obsidian/app.json

# ComfyUI server log captured by npc_art.ensure_server() - runtime artifact,
# truncated every server start, regenerated on demand.
tools/imageGen/comfy-server.log

# Wonderdraft map tooling: the gcpf codec is compiled per machine on first run.
tools/wonderdraft/gcpf
tools/wonderdraft/.venv/
tools/wonderdraft/assetgen/.venv/

# region-page generators: Python bytecode cache
tools/region-pages/__pycache__/
# scene-art test rounds (keep the chosen renders only)
tools/imageGen/scenes/*/round*/
