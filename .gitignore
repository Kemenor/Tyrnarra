# Ship the whole .claude/ project config (skills, hooks, commands, agents,
# settings.json, launch.json, serve script) so both machines stay in sync.
# Exclude only the genuinely per-machine files:
#   - settings.local.json: local permission grants, not meant to be shared.
.claude/settings.local.json
*.local.json
#   - transient runtime state (lock files, etc.)
.claude/*.lock

# Full-resolution dungeon / battlemap sources (the user's CzePeku / Tom Cartos
# subscription downloads and other licensed assets) are kept LOCAL ONLY and never
# published to GitHub Pages. Drop full-res originals in a `_full/` subfolder:
# under a campaign's maps/ for campaign-specific art, or under the shared
# campaigns/map-library/ for reusable libraries. Only the downsized web copies
# (and the committed text catalogues) reach GitHub. The `.gitkeep` keeps each
# `_full/` present on a fresh clone.
campaigns/**/_full/*
!campaigns/**/_full/.gitkeep

# pf2e encounter-builder: the cloned Foundry bestiary source (~250MB, re-clonable)
# and the rebuildable SQLite snapshot are local-only build artifacts. Run
# `python rebuild.py` to regenerate both. Homebrew creature JSON IS committed.
campaigns/tools/encounterBuilder/_sources/
campaigns/tools/encounterBuilder/bestiary.db
campaigns/tools/encounterBuilder/items.db
campaigns/tools/encounterBuilder/__pycache__/

# Python bytecode caches anywhere under the GM tools.
__pycache__/
*.pyc

# API keys / secrets for the GM tools (fal.ai etc.) - LOCAL ONLY, never committed.
campaigns/tools/**/fal_key.txt
**/*.secret
campaigns/tools/**/.env

# Generated NPC portraits (the user's image-gen output) stay local until uploaded
# to Foundry; the prompts (*.portraits.json) are committed, the rendered images
# are not.
campaigns/**/portraits/
